     DRIVER = None
 
 
+
+def parse_compiler_version(output):
+    """Recognize the installed Swift driver's version, not arbitrary build digits."""
+    match = re.search(r"(?m)^(?:Apple )?Swift version (\d+)\.(\d+)(?:\.(\d+))?(?:\s|$)", output)
+    return tuple(int(part or 0) for part in match.groups()) if match else None
+
+
+def installed_compiler_version(compiler):
+    if not compiler:
+        return None
+    try:
+        result = subprocess.run([compiler, "--version"], capture_output=True,
+                                timeout=5, check=True, text=True)
+        return parse_compiler_version(result.stdout)
+    except (OSError, subprocess.SubprocessError):
+        return None
+
+
+COMPILER_VERSION = installed_compiler_version(COMPILER)
+
