{"id": "python-74-solution", "lessonId": "python-74", "code": "def total_prefix(values, count):\n    total = 0\n    for index in range(count):\n        total += values[index]\n    return total", "checks": [{"label": "Minimal regression", "expression": "total_prefix([4], 0) == 0 and total_prefix([], 0) == 0"}, {"label": "Exact prefix", "expression": "total_prefix([4, 7, 9], 2) == 11"}, {"label": "All values", "expression": "total_prefix([4, 7, 9], 3) == 20"}, {"label": "Preserve input values", "expression": "(lambda x: (total_prefix(x, 2), x))([2, 8, 5]) == (10, [2, 8, 5])"}], "extraFiles": [], "mode": "solution"}