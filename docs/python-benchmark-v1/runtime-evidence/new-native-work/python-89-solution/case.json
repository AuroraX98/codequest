{"id": "python-89-solution", "lessonId": "python-89", "code": "def first_title(groups: dict[str, list[str]], key: str) -> str | None:\n    titles = groups.get(key, [])\n    return titles[0] if titles else None\n\ndef identity_count(value: int) -> int:\n    return value\n", "checks": [{"label": "First title", "expression": "first_title({'today': ['Read', 'Draw']}, 'today') == 'Read'"}, {"label": "Changed key", "expression": "first_title({'later': ['Explore']}, 'later') == 'Explore'"}, {"label": "Empty list", "expression": "first_title({'today': []}, 'today') is None"}, {"label": "Missing key", "expression": "first_title({}, 'today') is None"}, {"label": "Annotations do not enforce execution", "expression": "identity_count('text') == 'text'"}], "extraFiles": [], "mode": "solution"}