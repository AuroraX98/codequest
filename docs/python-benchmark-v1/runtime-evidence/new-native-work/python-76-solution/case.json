{"id": "python-76-solution", "lessonId": "python-76", "code": "class Label:\n    def __init__(self, text):\n        self.text = text\n\n    def __str__(self):\n        return self.text\n\n    def __repr__(self):\n        return f\"Label({self.text!r})\"", "checks": [{"label": "Display and representation", "expression": "str(Label(\"Moon\")) == \"Moon\" and repr(Label(\"Moon\")) == \"Label('Moon')\""}, {"label": "Escaped input", "expression": "repr(Label(\"a\\nb\")) == \"Label(\" + repr(\"a\\nb\") + \")\""}, {"label": "Empty value", "expression": "str(Label(\"\")) == \"\" and repr(Label(\"\")) == \"Label('')\""}], "extraFiles": [], "mode": "solution"}