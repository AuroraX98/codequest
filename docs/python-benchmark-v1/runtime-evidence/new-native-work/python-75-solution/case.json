{"id": "python-75-solution", "lessonId": "python-75", "code": "def recursive_total(values):\n    if not values:\n        return 0\n    first = values[0]\n    rest_total = recursive_total(values[1:])\n    return first + rest_total", "checks": [{"label": "Base and singleton", "expression": "recursive_total([]) == 0 and recursive_total([7]) == 7"}, {"label": "Several calls", "expression": "recursive_total([2, 5, -1]) == 6"}, {"label": "No mutation", "expression": "(lambda x: (recursive_total(x), x))([3, 4]) == (7, [3, 4])"}], "extraFiles": [], "mode": "solution"}