{"id": "python-56-solution", "lessonId": "python-56", "mode": "solution", "code": "def route(command):\n    match command:\n        case [\"greet\", name] if isinstance(name, str):\n            return f\"Hello {name}\"\n        case [\"pause\"]:\n            return \"Paused\"\n        case _:\n            return \"Unknown\"\n", "checks": [{"label": "String greeting and exact name", "expression": "route([\"greet\", \"Caf\u00e9 day\"]) == \"Hello Caf\u00e9 day\""}, {"label": "Literal case", "expression": "route([\"pause\"]) == \"Paused\""}, {"label": "Guard and shape rejection", "expression": "route([\"greet\", 7]) == \"Unknown\" and route([\"greet\", \"A\", \"B\"]) == \"Unknown\" and route(\"pause\") == \"Unknown\""}, {"label": "Tuple sequence and empty input", "expression": "route((\"greet\", \"Ada\")) == \"Hello Ada\" and route([]) == \"Unknown\""}], "extraFiles": []}