{"id": "python-30-solution", "lessonId": "python-30", "mode": "solution", "code": "def read_note(path):\n    with open(path, \"r\", encoding=\"utf-8\") as handle:\n        return handle.read()", "checks": [{"label": "Line breaks and spaces are preserved", "expression": "read_note(\"field-note.txt\") == 'Stars\\n  Look again.\\n'"}, {"label": "UTF-8 text is read as characters", "expression": "read_note(\"unicode-note.txt\") == \"Caf\u00e9 and \u661f\""}, {"label": "Empty file returns empty text", "expression": "read_note(\"empty-note.txt\") == \"\""}, {"label": "Reading does not change the file", "expression": "read_note(\"field-note.txt\") == read_note(\"field-note.txt\")"}], "extraFiles": [{"name": "field-note.txt", "code": "Stars\n  Look again.\n"}, {"name": "unicode-note.txt", "code": "Caf\u00e9 and \u661f"}, {"name": "empty-note.txt", "code": ""}, {"name": "demo-note.txt", "code": "A clear night.\n"}]}