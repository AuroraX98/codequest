{"id": "python-43-solution", "lessonId": "python-43", "mode": "solution", "code": "import json\n\ndef export_note(note):\n    return json.dumps(note, ensure_ascii=False, sort_keys=True)", "checks": [{"label": "Return parseable text preserving data", "expression": "(lambda value: isinstance(export_note(value),str) and json.loads(export_note(value)) == value)({\"title\":\"Moon\",\"done\":False,\"extra\":None})"}, {"label": "NonASCII remains readable", "expression": "\"Caf\u00e9\" in export_note({\"title\":\"Caf\u00e9\"})"}, {"label": "Keys sorted in encoded text", "expression": "list(json.loads(export_note({\"z\":1,\"a\":2}))) == [\"a\",\"z\"]"}, {"label": "Quotes and newlines safely roundtrip", "expression": "(lambda value: json.loads(export_note(value)) == value)({\"title\":\"A \\\"quote\\\"\\nnext\"})"}, {"label": "Input order not mutated", "expression": "(lambda value: export_note(value) and list(value) == [\"z\",\"a\"])({\"z\":1,\"a\":2})"}], "extraFiles": []}