{"id": "python-46-solution", "lessonId": "python-46", "mode": "solution", "code": "from itertools import islice\n\ndef first_items(items, limit):\n    return list(islice(items, limit))", "checks": [{"label": "Keep order and requested count", "expression": "first_items([4,8,12,16],2) == [4,8]"}, {"label": "Short and empty inputs", "expression": "first_items([1],5) == [1] and first_items([],3) == []"}, {"label": "Zero does not consume", "expression": "(lambda stream: first_items(stream,0) == [] and next(stream) == 7)(iter([7,8]))"}, {"label": "Leave the remaining stream available", "expression": "(lambda stream: first_items(stream,2) == [1,2] and next(stream) == 3)(iter([1,2,3]))"}, {"label": "Endless input is bounded", "expression": "first_items(__import__(\"itertools\").count(10),3) == [10,11,12]"}], "extraFiles": []}