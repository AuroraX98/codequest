{"id": "python-39-solution", "lessonId": "python-39", "mode": "solution", "code": "from pathlib import Path\n\ndef describe_note(path_text):\n    p = Path(path_text)\n    return {\"name\": p.name, \"stem\": p.stem, \"suffix\": p.suffix, \"markdown\": str(p.with_suffix(\".md\"))}", "checks": [{"label": "Parent folders are kept", "expression": "describe_note(\"notes/sky.txt\") == {\"name\":\"sky.txt\",\"stem\":\"sky\",\"suffix\":\".txt\",\"markdown\":str(Path(\"notes/sky.md\"))}"}, {"label": "A missing suffix is added", "expression": "describe_note(\"draft\") == {\"name\":\"draft\",\"stem\":\"draft\",\"suffix\":\"\",\"markdown\":\"draft.md\"}"}, {"label": "Only the last suffix is replaced", "expression": "describe_note(\"archive.tar.gz\")[\"markdown\"] == \"archive.tar.md\""}, {"label": "A leading-dot name is not treated as a txt suffix", "expression": "describe_note(\".draft\")[\"suffix\"] == \"\" and describe_note(\".draft\")[\"markdown\"] == \".draft.md\""}], "extraFiles": []}