{"id": "python-57-solution", "lessonId": "python-57", "mode": "solution", "code": "def utf8_summary(text):\n    encoded = text.encode(\"utf-8\")\n    return len(encoded), encoded.decode(\"utf-8\")", "checks": [{"label": "Multibyte and ASCII", "expression": "utf8_summary(\"\u00e9\") == (2, \"\u00e9\") and utf8_summary(\"A\") == (1, \"A\")"}, {"label": "Empty text", "expression": "utf8_summary(\"\") == (0, \"\")"}, {"label": "Exact combining sequence and emoji", "expression": "utf8_summary(\"e\u0301\") == (3, \"e\u0301\") and utf8_summary(\"\ud83c\udf31\") == (4, \"\ud83c\udf31\")"}], "extraFiles": []}