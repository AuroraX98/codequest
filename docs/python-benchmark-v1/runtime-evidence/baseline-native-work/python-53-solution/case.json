{"id": "python-53-solution", "lessonId": "python-53", "mode": "solution", "code": "def __preserves_values():\n    source = [\"az\", \"ba\"]\n    result = order_by_last(source)\n    return source == [\"az\", \"ba\"] and result is not source\n\ndef order_by_last(values):\n    return sorted(values, key=lambda text: text[-1])", "checks": [{"label": "Last character key", "expression": "order_by_last([\"za\", \"ab\", \"yc\"]) == [\"za\", \"ab\", \"yc\"]"}, {"label": "Not first character", "expression": "order_by_last([\"az\", \"ba\"]) == [\"ba\", \"az\"]"}, {"label": "Stable equal keys", "expression": "order_by_last([\"za\", \"aa\"]) == [\"za\", \"aa\"]"}, {"label": "Empty list", "expression": "order_by_last([]) == []"}, {"label": "Source unchanged and new result", "expression": "__preserves_values()"}], "extraFiles": []}