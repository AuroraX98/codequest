{"id": "python-42-solution", "lessonId": "python-42", "mode": "solution", "code": "from collections import defaultdict\n\ndef group_titles(rows):\n    groups = defaultdict(list)\n    for category, title in rows:\n        groups[category].append(title)\n    return dict(groups)", "checks": [{"label": "Group interleaved rows in original order", "expression": "group_titles([(\"A\",\"first\"),(\"B\",\"other\"),(\"A\",\"second\")]) == {\"A\":[\"first\",\"second\"],\"B\":[\"other\"]}"}, {"label": "Keep duplicate titles", "expression": "group_titles([(\"A\",\"same\"),(\"A\",\"same\")]) == {\"A\":[\"same\",\"same\"]}"}, {"label": "Empty produces ordinary dictionary", "expression": "type(group_titles([])) is dict and group_titles([]) == {}"}, {"label": "Separate calls do not share lists", "expression": "group_titles([(\"A\",\"one\")]) == {\"A\":[\"one\"]} and group_titles([(\"A\",\"two\")]) == {\"A\":[\"two\"]}"}, {"label": "Rows unchanged", "expression": "(lambda rows: group_titles(rows) == {\"A\":[\"x\"]} and rows == [(\"A\",\"x\")])([(\"A\",\"x\")])"}], "extraFiles": []}