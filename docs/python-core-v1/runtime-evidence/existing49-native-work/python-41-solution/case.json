{"id": "python-41-solution", "lessonId": "python-41", "mode": "solution", "code": "from collections import Counter\n\ndef topic_counts(topics):\n    return dict(Counter(topics))", "checks": [{"label": "Repeated entries counted", "expression": "topic_counts([\"sky\",\"sea\",\"sky\"]) == {\"sky\":2,\"sea\":1}"}, {"label": "Case preserved", "expression": "topic_counts([\"Read\",\"read\",\"Read\"]) == {\"Read\":2,\"read\":1}"}, {"label": "Empty input", "expression": "topic_counts([]) == {}"}, {"label": "Return ordinary dictionary", "expression": "type(topic_counts([\"A\"])) is dict"}, {"label": "Input retained", "expression": "(lambda data: topic_counts(data) == {\"A\":2} and data == [\"A\",\"A\"])([\"A\",\"A\"])"}], "extraFiles": []}