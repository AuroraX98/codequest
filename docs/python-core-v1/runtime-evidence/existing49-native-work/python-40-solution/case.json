{"id": "python-40-solution", "lessonId": "python-40", "mode": "solution", "code": "from datetime import date, timedelta\n\ndef shift_date(day_text, days):\n    day = date.fromisoformat(day_text)\n    return (day + timedelta(days=days)).isoformat()", "checks": [{"label": "Month boundary", "expression": "shift_date(\"2026-04-30\",1) == \"2026-05-01\""}, {"label": "Leap day", "expression": "shift_date(\"2024-02-28\",1) == \"2024-02-29\""}, {"label": "Backward across year boundary", "expression": "shift_date(\"2026-01-01\",-1) == \"2025-12-31\""}, {"label": "Zero retains day", "expression": "shift_date(\"2026-10-27\",0) == \"2026-10-27\""}, {"label": "Use the actual offset", "expression": "shift_date(\"2026-05-01\",3) == \"2026-05-04\""}], "extraFiles": []}