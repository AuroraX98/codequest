{"id": "python-47-solution", "lessonId": "python-47", "mode": "solution", "code": "def score_total(*scores):\n    total = 0\n    for score in scores:\n        total = total + score\n    return total", "checks": [{"label": "Variable number of inputs", "expression": "score_total(2,3,7) == 12"}, {"label": "Empty argument tuple", "expression": "score_total() == 0"}, {"label": "Negative and fractional values", "expression": "score_total(-2,1.5,4) == 3.5"}, {"label": "Unpacked sequence supplies separate arguments", "expression": "score_total(*[4,5]) == 9"}], "extraFiles": []}