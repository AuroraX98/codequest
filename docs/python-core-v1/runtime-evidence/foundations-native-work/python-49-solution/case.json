{"id": "python-49-solution", "mode": "solution", "code": "def band(score):\n    if score >= 80:\n        return \"high\"\n    elif score >= 50:\n        return \"middle\"\n    else:\n        return \"low\"", "checks": [{"label": "Upper boundary", "expression": "band(80) == \"high\""}, {"label": "Middle boundary", "expression": "band(50) == \"middle\""}, {"label": "Below middle", "expression": "band(49) == \"low\""}, {"label": "Overlapping conditions", "expression": "band(100) == \"high\""}], "extraFiles": []}