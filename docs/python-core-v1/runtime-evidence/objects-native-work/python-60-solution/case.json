{"id": "python-60-solution", "lessonId": "python-60", "mode": "solution", "code": "class Label:\n    def __init__(self, text):\n        self.text = text\n\n    def render(self):\n        return self.text\n\nclass FramedLabel(Label):\n    def render(self):\n        return \"[\" + super().render() + \"]\"\n", "checks": [{"label": "Base and derived behavior", "expression": "Label(\"Map\").render() == \"Map\" and FramedLabel(\"Map\").render() == \"[Map]\""}, {"label": "Empty and Unicode text", "expression": "FramedLabel(\"\").render() == \"[]\" and FramedLabel(\"Caf\u00e9\").render() == \"[Caf\u00e9]\""}, {"label": "Stored input unchanged", "expression": "(lambda x: x.render() == \"[A]\" and x.text == \"A\")(FramedLabel(\"A\"))"}], "extraFiles": []}