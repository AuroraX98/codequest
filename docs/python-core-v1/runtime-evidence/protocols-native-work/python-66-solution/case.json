{"id": "python-66-solution", "lessonId": "python-66", "mode": "solution", "code": "def save_note(path, text, append=False):\n    mode = \"a\" if append else \"w\"\n    with open(path, mode, encoding=\"utf-8\") as handle:\n        return handle.write(text)\n\ndef __read_note(path):\n    with open(path, \"r\", encoding=\"utf-8\") as handle:\n        return handle.read()", "checks": [{"label": "Unicode character count", "expression": "save_note(\"check-write.txt\",\"\u00e9\\n\")==2 and __read_note(\"check-write.txt\")==\"\u00e9\\n\""}, {"label": "Replacement", "expression": "save_note(\"check-replace.txt\",\"old\")==3 and save_note(\"check-replace.txt\",\"new\")==3 and __read_note(\"check-replace.txt\")==\"new\""}, {"label": "Append", "expression": "save_note(\"check-append.txt\",\"A\")==1 and save_note(\"check-append.txt\",\"B\",append=True)==1 and __read_note(\"check-append.txt\")==\"AB\""}, {"label": "Empty replacement", "expression": "save_note(\"check-empty.txt\",\"old\")==3 and save_note(\"check-empty.txt\",\"\")==0 and __read_note(\"check-empty.txt\")==\"\""}], "extraFiles": []}