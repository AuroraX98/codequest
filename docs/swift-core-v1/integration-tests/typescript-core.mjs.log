      starter: '<!doctype html><html lang="en"><head><meta charset="utf-8"><title>Neighborhood art day</title></head><body><h1>Art day</h1><p>Saturday at the library.</p><a href="#schedule">Schedule</a><h2 id="schedule">Schedule</h2><!-- TODO: wrap parts in header/nav/main/footer --></body></html>',
      solution: '<!doctype html><html lang="en"><head><meta charset="utf-8"><title>Neighborhood art day</title></head><body><header><h1>Neighborhood art day</h1></header><nav aria-label="Event navigation"><a href="#schedule">Schedule</a></nav><main><p>Saturday at the library.</p><section id="schedule"><h2>Schedule</h2><p>Make a collage.</p></section></main><footer><p>Supplies are provided.</p></footer></body></html>',
