      starter: '<!doctype html><html lang="en"><head><meta charset="utf-8"><title>Willow Beach</title></head><body><h1>Willow Beach</h1><!-- TODO: add paragraph, link and described image --></body></html>',
      solution: '<!doctype html><html lang="en"><head><meta charset="utf-8"><title>Willow Beach</title></head><body><h1>Willow Beach</h1><p>I like the quiet path beside the water.</p><a href="https://example.org/trail">See the trail guide</a><img src="beach.jpg" alt="A sandy beach beside calm water"></body></html>',
      runtime: 'html',
